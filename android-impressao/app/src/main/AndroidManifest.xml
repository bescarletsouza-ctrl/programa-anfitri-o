<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Check-in (página do site) + impressão por Wi-Fi -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- leitor de QR do crachá -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="We.events Check-in"
        android:theme="@style/Theme.App">

        <!-- O app: check-in (WebView) com impressão direta na Brother -->
        <activity
            android:name=".CheckinActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App.Checkin"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Configuração da impressora (IP, etiqueta, teste), aberta pelo menu do check-in -->
        <activity
            android:name=".ConfigActivity"
            android:exported="false" />
    </application>
</manifest>
